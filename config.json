{
    "container": {
        "image": "eda-env-designer:gf180mcuD"
    },
    "dir": {
        "testbench": "tb",
        "simulation": "sim"
    },
    "technology": {
        "mosfet_limits": {
            "lv": {"vgs_max": 3.3, "vds_max": 3.3, "vgb_max": 3.3, "vdb_max": 3.3, "vsb_max": 3.3},
            "hv": {"vgs_max": 6.0, "vds_max": 6.0, "vgb_max": 6.0, "vdb_max": 6.0, "vsb_max": 6.0}
        }
    },
    "defaults": {
        "vdd": "5.0",
        "dvdd": "3.3",
        "vco_vdd": "3.3",
        "vtune": "2.5",
        "ibias": "100n",
        "cload": "1.0f",
        "temperature": "25",
        "corner": "tt"
    },
    "blocks": {
        "inductor": {
            "symbol": "inductor.sym",
            "topologies": {
                "placeholder_rlc": {
                    "description": "Fixed RLC-pi equivalent (2.895nH per half, center-tapped), carried over verbatim from opensubghz's sky130_fd_pr__ind_05_125 -- NOT a real GF180MCU inductor model. Split out as its own block (a/b/ct/sub interface) specifically so a real characterized/EM-extracted model can be added later as a sibling topology sharing the same interface, without touching whatever instantiates sch/inductor.sym.",
                    "references": [
                        "opensubghz/xschem/vco_transfer_tb.sch's inline sky130_fd_pr__ind_05_125 RLC-pi model"
                    ],
                    "schematic": "inductor/inductor_placeholder_rlc.sch",
                    "parameters_file": "sch/inductor/inductor_placeholder_rlc.params.json"
                }
            }
        },
        "vco": {
            "symbol": "vco.sym",
            "topologies": {
                "quadrature_lc": {
                    "description": "Quadrature LC-VCO: two cross-coupled NMOS negative-gm cores (half_qvco_cell), each with its own LC tank, tail-coupled via an extra injection pair driven by the other core's differential output -- forces the two cores into quadrature lock. Ported from opensubghz's SKY130 half_qvco_param/vco_transfer_tb (nfet3_01v8 -> nfet_03v3, cap_var_lvt -> cap_nmos_03v3 MOS varactor). Runs on its own vco_vdd rail (3.3V, matching nfet_03v3's rating) rather than the chip's 5.0V analog rail. Inductor is a placeholder RLC subckt carried over verbatim from opensubghz -- not a real GF180MCU inductor model; pending rnxrbb's own inductor characterization work.",
                    "references": [
                        "opensubghz/xschem/half_qvco_param.sch, vco_transfer_tb.sch (SKY130 reference topology)"
                    ],
                    "schematic": "vco/vco_quadrature_lc.sch",
                    "parameters_file": "sch/vco/vco_quadrature_lc.params.json",
                    "sub_blocks": {
                        "XL1": {"block": "inductor", "topology": "placeholder_rlc"}
                    },
                    "structural_sub_blocks": {
                        "X1": {"schematic": "vco/half_qvco_cell.sch"},
                        "X2": {"schematic": "vco/half_qvco_cell.sch"}
                    }
                }
            }
        },
        "top": {
            "symbol": "top.sym"
        }
    },
    "tests": {
        "inductor": {
            "yparam": {
                "simulator": "ngspice",
                "testbench": "tb/inductor/tb_yparam.sch",
                "parser": "tb/inductor/tb_yparam.py",
                "outputs": [
                    {
                        "description": "Self-resonant frequency (SRF) -- also used as this block's maximum recommended operating frequency",
                        "unit": "GHz"
                    },
                    {
                        "description": "Peak Q factor across the AC sweep",
                        "unit": ""
                    }
                ],
                "conditions": {
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            }
        },
        "vco": {
            "op": {
                "simulator": "ngspice",
                "testbench": "tb/vco/tb_op.sch",
                "parser": "tb/vco/tb_op.py",
                "outputs": [
                    {
                        "description": "VCO core current consumption",
                        "unit": "uA"
                    }
                ],
                "conditions": {
                    "vco_vdd": ["3.3"],
                    "vtune": ["2.5"],
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            },
            "startup": {
                "simulator": "ngspice",
                "testbench": "tb/vco/tb_startup.sch",
                "parser": "tb/vco/tb_startup.py",
                "outputs": [
                    {
                        "description": "Startup time (envelope to 90% of steady-state amplitude)",
                        "unit": "ns"
                    },
                    {
                        "description": "Steady-state oscillation frequency",
                        "unit": "MHz"
                    },
                    {
                        "description": "Steady-state I differential output amplitude (peak-peak)",
                        "unit": "mV",
                        "minimum": 50
                    },
                    {
                        "description": "Steady-state Q differential output amplitude (peak-peak)",
                        "unit": "mV",
                        "minimum": 50
                    },
                    {
                        "description": "I/Q quadrature phase error (deviation from 90 degrees)",
                        "unit": "deg"
                    }
                ],
                "conditions": {
                    "vco_vdd": ["3.3"],
                    "vtune": ["2.2", "2.5", "2.8"],
                    "temperature": ["25"],
                    "corner": ["tt"],
                    "typical": {"corner": "tt", "temperature": "25", "vtune": "2.5"}
                }
            },
            "loop_gain": {
                "simulator": "ngspice",
                "testbench": "tb/vco/tb_loop_gain.sch",
                "parser": "tb/vco/tb_loop_gain.py",
                "outputs": [
                    {
                        "description": "Tank resonant frequency (Im(Y11) = 0)",
                        "unit": "GHz"
                    },
                    {
                        "description": "Net conductance at resonance (Re(Y11); negative = net negative resistance, oscillation should grow -- positive = net loss, matches a decaying tb_startup kick)",
                        "unit": "mS",
                        "maximum": 0
                    }
                ],
                "conditions": {
                    "vco_vdd": ["3.3"],
                    "vtune": ["2.5"],
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            }
        },
        "top": {
            "op": {
                "simulator": "ngspice",
                "testbench": "tb/top/tb_top_op.sch",
                "parser": "tb/top/tb_top_op.py",
                "outputs": [
                    {
                        "description": "Total PLL power consumption (proposal: low uW-mW range depending on frequency/loop bandwidth, no fixed target given)",
                        "unit": "mW"
                    }
                ],
                "conditions": {
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            },
            "spectral": {
                "simulator": "xyce",
                "testbench": "tb/top/tb_top_spectral.sch",
                "parser": "tb/top/tb_top_spectral.py",
                "outputs": [
                    {
                        "description": "SSB phase noise @ 1MHz offset (proposal target)",
                        "unit": "dBc/Hz",
                        "maximum": -120
                    },
                    {
                        "description": "In-band spurious tones (proposal target)",
                        "unit": "dBc",
                        "maximum": -70
                    }
                ],
                "conditions": {
                    "temperature": ["25"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            },
            "lock": {
                "simulator": "ngspice",
                "testbench": "tb/top/tb_top_lock.sch",
                "parser": "tb/top/tb_top_lock.py",
                "outputs": [
                    {
                        "description": "Lock acquisition time (proposal: \"within a few hundred microseconds\" -- 500us used as an approximate target pending a firmer spec)",
                        "unit": "us",
                        "maximum": 500
                    }
                ],
                "conditions": {
                    "temperature": ["25"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            },
            "freq_range": {
                "simulator": "ngspice",
                "testbench": "tb/top/tb_top_freq_range.sch",
                "parser": "tb/top/tb_top_freq_range.py",
                "outputs": [
                    {
                        "description": "Output frequency range (proposal: ISM band 902-928MHz)",
                        "unit": "MHz",
                        "minimum": 902,
                        "maximum": 928
                    },
                    {
                        "description": "Fractional tuning range (proposal target)",
                        "unit": "%",
                        "minimum": 20
                    }
                ],
                "conditions": {
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"],
                    "typical": {"corner": "tt", "temperature": "25"}
                }
            }
        }
    }
}
